<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:CouchPad.App.Localization"
        xmlns:vm="using:CouchPad.App.ViewModels"
        x:Class="CouchPad.App.Views.PerformanceHudOverlayWindow"
        x:DataType="vm:PerformanceHudViewModel"
        Title="{loc:Tr hud.overlay.title}"
        Width="300"
        Height="210"
        CanResize="False"
        Focusable="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual"
        Background="Transparent">
  <Viewbox Stretch="Uniform">
    <Border Width="300"
            Height="210"
            Padding="14"
            CornerRadius="16"
            Background="#FF0B1117"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            IsHitTestVisible="False">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="6" Height="6" CornerRadius="3"
                  Background="{DynamicResource CouchPad.Accent}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Margin="7,0,0,0"
                     Text="{loc:Tr hud.overlay.title}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CouchPad.TextPrimary}" />
          <TextBlock Grid.Column="2"
                     Text="{loc:Tr app.name}"
                     FontSize="9"
                     Foreground="{DynamicResource CouchPad.TextSecondary}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="3" IsVisible="{Binding ShowCpu}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr hud.metric.cpu}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CouchPad.TextPrimary}" />
            </Grid>
            <Border Height="3" CornerRadius="2" Background="#22FFFFFF" ClipToBounds="True">
              <Border Width="{Binding CpuBarWidth}" Height="3" CornerRadius="2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource CouchPad.Accent}" />
            </Border>
            <TextBlock Text="{Binding CpuGameText}"
                       IsVisible="{Binding ShowCpuProcess}"
                       FontSize="8"
                       Foreground="{DynamicResource CouchPad.TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding ShowGpu}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr hud.metric.gpu}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CouchPad.TextPrimary}" />
            </Grid>
            <Border Height="3" CornerRadius="2" Background="#22FFFFFF" ClipToBounds="True">
              <Border Width="{Binding GpuBarWidth}" Height="3" CornerRadius="2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource CouchPad.Accent2}" />
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="3" IsVisible="{Binding ShowRam}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr hud.metric.ram}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding RamText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource CouchPad.TextPrimary}" />
            </Grid>
            <Border Height="3" CornerRadius="2" Background="#22FFFFFF" ClipToBounds="True">
              <Border Width="{Binding RamBarWidth}" Height="3" CornerRadius="2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource CouchPad.Accent}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding ShowVram}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr hud.metric.vram}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding VramText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource CouchPad.TextPrimary}" />
            </Grid>
            <Border Height="3" CornerRadius="2" Background="#22FFFFFF" ClipToBounds="True">
              <Border Width="{Binding VramBarWidth}" Height="3" CornerRadius="2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource CouchPad.Accent2}" />
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="3" VerticalAlignment="Bottom">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowProcess}">
            <TextBlock Text="{loc:Tr hud.metric.process}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
            <TextBlock Grid.Column="1" Text="{Binding ProcessText}" FontSize="9" Foreground="{DynamicResource CouchPad.TextPrimary}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowDisplay}">
            <TextBlock Text="{loc:Tr hud.metric.display}" FontSize="9" Foreground="{DynamicResource CouchPad.TextSecondary}" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="9" Foreground="{DynamicResource CouchPad.TextPrimary}" />
          </Grid>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="{loc:Tr hud.overlay.empty}"
                   IsVisible="{Binding ShowEmpty}"
                   FontSize="9"
                   Foreground="{DynamicResource CouchPad.TextSecondary}" />
      </Grid>
    </Border>
  </Viewbox>
</Window>

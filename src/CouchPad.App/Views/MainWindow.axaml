<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:CouchPad.App.Localization"
        xmlns:vm="using:CouchPad.App.ViewModels"
        x:Class="CouchPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr app.name}"
        Width="1020"
        Height="780"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CouchPad.Background}"
        FontFamily="{DynamicResource CouchPad.FontFamily}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource CouchPad.Padding.Window}">

    <!-- Cabeçalho -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="34"
                Height="34"
                CornerRadius="{DynamicResource CouchPad.Radius.Control}"
                Background="{DynamicResource CouchPad.AccentMuted}">
          <TextBlock Text="C"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CouchPad.Accent}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr app.name}"
                     FontSize="{DynamicResource CouchPad.FontSize.H1}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{loc:Tr app.tagline}"
                     FontSize="{DynamicResource CouchPad.FontSize.Caption}"
                     Foreground="{DynamicResource CouchPad.TextSecondary}" />
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="2"
              Background="{DynamicResource CouchPad.AccentMuted}"
              CornerRadius="{DynamicResource CouchPad.Radius.Pill}"
              Padding="10,5"
              VerticalAlignment="Center">
        <TextBlock Text="{loc:Tr status.free}"
                   FontSize="{DynamicResource CouchPad.FontSize.Caption}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CouchPad.Accent}" />
      </Border>
    </Grid>

    <!-- Conteúdo do P0 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CouchPad.Surface}"
            BorderBrush="{DynamicResource CouchPad.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CouchPad.Radius.CardLarge}"
            Padding="{DynamicResource CouchPad.Padding.Card}">
      <StackPanel Spacing="12"
                  MaxWidth="640"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
        <TextBlock Text="{loc:Tr p0.title}"
                   FontSize="{DynamicResource CouchPad.FontSize.Display}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Tr p0.body}"
                   FontSize="{DynamicResource CouchPad.FontSize.Body}"
                   Foreground="{DynamicResource CouchPad.TextSecondary}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0">
          <Button Classes="secondary"
                  Content="{loc:Tr language.ptbr}"
                  Command="{Binding SetPortugueseCommand}" />
          <Button Classes="secondary"
                  Content="{loc:Tr language.en}"
                  Command="{Binding SetEnglishCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Rodapé -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock Text="{Binding VersionText}"
                 FontSize="{DynamicResource CouchPad.FontSize.Caption}"
                 Foreground="{DynamicResource CouchPad.TextSecondary}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{loc:Tr footer.phase}"
                 FontSize="{DynamicResource CouchPad.FontSize.Caption}"
                 Foreground="{DynamicResource CouchPad.TextSecondary}"
                 VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>

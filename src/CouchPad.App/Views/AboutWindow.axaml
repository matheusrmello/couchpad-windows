<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:CouchPad.App.Localization"
        xmlns:vm="using:CouchPad.App.ViewModels"
        x:Class="CouchPad.App.Views.AboutWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr about.title}"
        Icon="avares://CouchPad/Assets/couchpad.ico"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CouchPad.Background}"
        Foreground="{DynamicResource CouchPad.TextPrimary}"
        FontSize="{DynamicResource CouchPad.FontSize.Body}"
        FontFamily="{DynamicResource CouchPad.FontFamily}">

  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18"
        Margin="{DynamicResource CouchPad.Padding.Window}">

    <Border Background="{DynamicResource CouchPad.Surface}"
            BorderBrush="{DynamicResource CouchPad.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CouchPad.Radius.CardLarge}"
            Padding="{DynamicResource CouchPad.Padding.Card}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Image Width="54" Height="54"
               Source="avares://CouchPad/Assets/couchpad.png"
               Stretch="Uniform"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{loc:Tr app.name}"
                       FontSize="{DynamicResource CouchPad.FontSize.Display}"
                       FontWeight="SemiBold" />
            <Border Grid.Column="1"
                    Background="{DynamicResource CouchPad.AccentMuted}"
                    CornerRadius="{DynamicResource CouchPad.Radius.Pill}"
                    Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding VersionText}"
                         FontSize="{DynamicResource CouchPad.FontSize.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource CouchPad.Accent}" />
            </Border>
          </Grid>
          <TextBlock Text="{loc:Tr app.tagline}" TextWrapping="Wrap"
                     Foreground="{DynamicResource CouchPad.TextSecondary}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="{loc:Tr about.description}"
               TextWrapping="Wrap" LineHeight="20" />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto"
          Margin="0,2,0,0">
      <TextBlock Classes="caption"
                 Text="{loc:Tr about.license}"
                 VerticalAlignment="Center" />
      <Button x:Name="CloseButton"
              Grid.Column="1"
              Classes="secondary"
              Content="{loc:Tr about.close}"
              IsDefault="True"
              IsCancel="True"
              Click="OnCloseClick" />
    </Grid>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CouchPad</AssemblyName>
    <RootNamespace>CouchPad.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\couchpad.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CouchPad.Core\CouchPad.Core.csproj" />
    <ProjectReference Include="..\CouchPad.Platform.Windows\CouchPad.Platform.Windows.csproj" />
    <ProjectReference Include="..\CouchPad.Rescue\CouchPad.Rescue.csproj" ReferenceOutputAssembly="false" Condition="'$(CouchPadInstallerPublish)' != 'true'" />
    <ProjectReference Include="..\CouchPad.Notifications.Windows\CouchPad.Notifications.Windows.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Condition="'$(CouchPadInstallerPublish)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\couchpad.png" />
    <AvaloniaResource Include="Assets\couchpad.ico" />
    <Content Include="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyRescueArtifacts" AfterTargets="Build" Condition="'$(CouchPadInstallerPublish)' != 'true'">
    <ItemGroup>
      <_RescueArtifact Include="$(MSBuildThisFileDirectory)..\CouchPad.Rescue\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\CouchPad.Rescue.exe;$(MSBuildThisFileDirectory)..\CouchPad.Rescue\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\CouchPad.Rescue.dll;$(MSBuildThisFileDirectory)..\CouchPad.Rescue\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\CouchPad.Rescue.deps.json;$(MSBuildThisFileDirectory)..\CouchPad.Rescue\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\CouchPad.Rescue.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_RescueArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNotificationArtifacts" AfterTargets="Build" Condition="'$(CouchPadInstallerPublish)' != 'true'">
    <ItemGroup>
      <_NotificationArtifact Include="$(MSBuildThisFileDirectory)..\CouchPad.Notifications.Windows\bin\$(Configuration)\net10.0-windows10.0.18362.0\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NotificationArtifact)" DestinationFiles="@(_NotificationArtifact->'$(OutDir)notifications\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="IncludeNotificationArtifactsInPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(CouchPadInstallerPublish)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)..\CouchPad.Notifications.Windows\bin\$(Configuration)\net10.0-windows10.0.18362.0\win-x64\**\*">
        <RelativePath>notifications\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="IncludeRescueAssemblyInPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(CouchPadInstallerPublish)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)..\CouchPad.Rescue\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\CouchPad.Rescue.dll">
        <RelativePath>CouchPad.Rescue.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Version>1.0.15</Version>
    <Company>CouchPad</Company>
    <Product>CouchPad</Product>
    <Authors>Matheus Mello</Authors>
    <Copyright>Copyright (c) 2026 Matheus Mello</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- NU1900 = fonte de auditoria do NuGet indisponível (ambiente offline).
         Não é uma vulnerabilidade; a auditoria continua ativa quando a fonte
         estiver acessível. Ver D030 em docs/decisions.md. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
</Project>
